?start: script

script: (statement | flow_definition | run_statement)*

statement: simple_command
         | when_statement
         | if_statement

simple_command: VERB parameter*

parameter: KEY "=" value

?value: STRING
      | NUMBER
      | list
      | geometry
      | TRUE
      | FALSE

list: "[" [value ("," value)*] "]"

geometry: point | circle | box | polygon

point: "point(" NUMBER "," NUMBER ")"
circle: "circle(" NUMBER "," NUMBER "," NUMBER ")"
box: "box(" NUMBER "," NUMBER "," NUMBER "," NUMBER ")"

polygon: "polygon(" NUMBER "," NUMBER ("," NUMBER "," NUMBER)+ ")"

when_statement: "when" condition block
if_statement: "if" condition block ["else" block]

block: INDENT statement+ DEDENT

condition: simple_condition
         | "(" condition ")"
         | condition LOGIC condition

simple_condition: KEY OP value
                | function_call OP value
                | KEY "in" list

function_call: FUNCTION "(" [arguments] ")"
arguments: value ("," value)*

flow_definition: "flow" IDENTIFIER "=" block
run_statement: "run" IDENTIFIER ["every" period]

period: "night"
      | "hour"
      | "minute"
      | NUMBER UNIT

UNIT: "s" | "m" | "h" | "d"

LOGIC: "and" | "or"
OP: "=" | "<" | ">" | "<=" | ">=" | "!=" | "contains" | "matches"

VERB: "find" | "monitor" | "lightcurve" | "classify"
    | "crossmatch" | "save" | "alert" | "analyze"
    | "get" | "confirm" | "score" | "cutout"

KEY: /[a-zA-Z_][a-zA-Z0-9_]*/
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

TRUE: "true"
FALSE: "false"

STRING: ESCAPED_STRING
NUMBER: SIGNED_NUMBER

%import common.ESCAPED_STRING
%import common.SIGNED_NUMBER
%import common.WS
%ignore WS
