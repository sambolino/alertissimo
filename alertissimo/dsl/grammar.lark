// Alertissimo declarative DSL v0.1
//
// This file is the hand-authored formal syntax of the user-facing language.
// It is intentionally not generated from orchestration Step classes.
// WHERE/FILTER and WITH-scoped predicate slots are parsed by the independent
// hand-authored expression grammar in expression.lark. ORDER, RANKED, and
// MATCH ON remain separate semantic slots because they are not ordinary boolean
// predicates in v0.1.
//
// Dimensional vocabulary is intentional: WITHIN expresses temporal extent,
// INSIDE expresses spatial extent, and MATCH ON introduces the pairwise
// relationship criterion. A positional Match therefore reads, for example,
// "match on position inside 1arcsec".
//
// Layout rule: indentation is cosmetic everywhere in the DSL. Predicate grouping
// is always explicit in expression syntax. A WITH-scoped predicate is written
// inline as "with <requirement> where <expression>"; multiple conditions must use
// explicit AND/OR rather than indentation or line breaks.

start: script
// A trailing newline is optional: text areas and APIs commonly submit the last
// clause without one.
script: _NL* candidate_statement (_NL clause)* _NL*

candidate_statement: "objects"i "from"i origin_list via_clause?
origin_list: NAME ("," NAME)*
broker_list: NAME ("," NAME)*

?clause: simple_clause
       | with_clause

?simple_clause: inside_clause
              | within_clause
              | latest_clause
              | where_clause
              | filter_clause
              | confirm_clause
              | match_clause
              | order_clause
              | ranked_clause

inside_clause: "inside"i "(" NUMBER "," NUMBER "," ANGLE ")"

within_clause: "within"i duration                       -> within_relative
             | "within"i WINDOW_BOUND "," WINDOW_BOUND -> within_explicit

latest_clause: "latest"i INT
where_clause: "where"i TEXT
filter_clause: "filter"i TEXT
confirm_clause: "confirm"i "by"i INT "via"i broker_list

// WITH predicates are inline and explicit. There is no indentation-based scope
// and no implicit conjunction between physical lines.
with_clause: "with"i requirement scoped_where?
scoped_where: "where"i TEXT

requirement: PRODUCT from_clause? via_clause? using_clause?
from_clause: "from"i NAME
via_clause: "via"i NAME
using_clause: "using"i METHOD

match_clause: "match"i match_from? via_clause? match_within? match_on?
match_from: "from"i NAME
match_within: "within"i duration
match_on: "on"i TEXT

order_clause: "order"i "by"i TEXT
ranked_clause: "ranked"i "by"i TEXT

duration: DURATION

PRODUCT.2: /[^:#\n]+?(?=\s+(?i:from|via|using|where)\s+[A-Za-z]|\s*(?:#|\n|$))/
TEXT: /[^#\n]+/
WINDOW_BOUND: /[^,#\n]+/
DURATION: /[+]?(?:\d+(?:\.\d*)?|\.\d+)(?:s|min|h|d|w)/i
ANGLE: /[+]?(?:\d+(?:\.\d*)?|\.\d+)(?:deg|arcmin|arcsec)?/i
METHOD: /[A-Za-z][A-Za-z0-9_.:-]*/
NAME: /[A-Za-z][A-Za-z0-9_.-]*/
NUMBER: /[+-]?(?:\d+(?:\.\d*)?|\.\d+)/
INT: /\d+/

COMMENT: /#[^\n]*/
_NL: /(\r?\n[\t ]*)+/

%import common.WS_INLINE
%ignore WS_INLINE
%ignore COMMENT
